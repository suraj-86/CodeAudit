# CodeAudit API — environment configuration
# Copy this file to .env and fill in what you need. Every variable below
# is optional: the server runs with sensible defaults if none are set
# (AI-assisted analysis simply reports itself unavailable without a key).

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------

# Port the API listens on.
# Render sets this automatically — leave unset in that environment.
# PORT=4000

# ---------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------

# Comma-separated list of origins allowed to call this API from a
# browser. Leave unset for local development (CORS stays wide open,
# since a dev frontend's origin is unpredictable — a Vite port, a LAN
# address, etc.). In production, set this to your real frontend's
# origin so the API isn't callable from any arbitrary website:
#   CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Multiple origins (e.g. production + a preview deployment):
#   CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-git-preview.vercel.app
# CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------
# AI-assisted analysis (Gemini)
# ---------------------------------------------------------------------

# Without a key, /api/analyze/ai and the AI step of /api/analyze/workflow
# both work normally and report { available: false } with a clear reason
# — nothing else is degraded.
# GEMINI_API_KEY=

# Defaults to gemini-3.5-flash (a stable, production-tier model).
# Avoid "-preview" model names here: preview models get far less serving
# capacity than stable releases and are prone to 503 "high demand" errors
# and request timeouts under ordinary load (see Decision 052).
# GEMINI_MODEL=gemini-3.5-flash

# Request timeout in milliseconds. Defaults to 15000 (15s).
# GEMINI_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# Code execution (Python correctness testing)
# ---------------------------------------------------------------------
# Requires Docker to be available to the server process, with the
# codeaudit/python image built (see server/runtime/python/Dockerfile).
# Without Docker, execution requests report "Execution Unavailable"
# rather than failing the whole request.

# Per-run timeout in milliseconds. Defaults to 5000 (5s).
# EXECUTION_TIMEOUT_MS=5000

# Max captured output per run, in bytes. Defaults to 65536 (64 KB).
# EXECUTION_MAX_OUTPUT_BYTES=65536
