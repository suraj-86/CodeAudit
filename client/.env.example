# Where the browser sends API requests.
# Leave unset to use "/api" — in development Vite proxies that path to the
# backend (see VITE_DEV_API_TARGET); in production it works when the
# frontend and backend share an origin (e.g. behind one reverse proxy).
# Set it to a full URL if the API lives on a different origin, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api
# (the backend then needs to allow that origin via CORS).
# VITE_API_BASE_URL=

# Development only: the backend Vite forwards /api to.
# VITE_DEV_API_TARGET=http://localhost:4000
